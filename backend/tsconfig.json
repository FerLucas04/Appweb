{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext", //imports .js en lugar de .ts
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true, //decoradores de TypeORM
    "emitDecoratorMetadata": true, //decoradores de TypeORM
    "strictPropertyInitialization": false,
    "types": ["node"]
  },
  "include": ["src/**/*"]
}